{
  "name": "discord-speech-recognition",
  "version": "4.0.0",
  "description": "Extension for making discord speech recognition bots.",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "watch": "tsdown --watch",
    "doc": "typedoc",
    "build": "tsdown",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ tests/ && oxfmt --check src/ tests/ && tsc --noEmit",
    "format": "oxfmt --write src/ tests/",
    "lint:fix": "oxlint --fix --type-aware src/ tests/ && oxfmt --write src/ tests/",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rei-x/discord-speech-recognition.git"
  },
  "keywords": [
    "discord.js",
    "discord",
    "discord-bot",
    "voice",
    "speech-recognition",
    "speech-to-text",
    "speechrecognition"
  ],
  "author": "Rei-x",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rei-x/discord-speech-recognition/issues"
  },
  "homepage": "https://discordsr.netlify.app/",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@discordjs/opus": "^0.10.0 || ^0.11.0",
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.0.0",
    "opusscript": "^0.0.8"
  },
  "dependencies": {
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@types/node": "^22.20.5",
    "@types/wav": "^1.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "discord.js": "^14.28.1",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "opusscript": "^0.0.8",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "~6.0",
    "vitest": "^5.1.0",
    "wav": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "@discordjs/opus": {
      "optional": true
    },
    "opusscript": {
      "optional": true
    }
  }
}
