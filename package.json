{
  "name": "discord-speech-recognition",
  "version": "3.4.1",
  "description": "Extension for making discord speech recognition bots.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "nodemon dist/index.js",
    "watch": "tsdown --watch",
    "doc": "typedoc",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware src/ && oxfmt --check src/ && tsc --noEmit",
    "format": "oxfmt --write src/ tests/",
    "lint:fix": "oxlint --fix --type-aware src/ && oxfmt --write src/",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rei-x/discord-speech-recognition.git"
  },
  "keywords": [
    "discord.js",
    "discord",
    "speechrecognition"
  ],
  "author": "Rei-x",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rei-x/discord-speech-recognition/issues"
  },
  "homepage": "https://discordsr.netlify.app/",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "discord.js": "14.x"
  },
  "dependencies": {
    "@snazzah/davey": "^0.1.10",
    "prism-media": "^2.0.0-alpha.0",
    "wav": "^1.0.2"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^25.3.5",
    "@types/node-wit": "^6.1.0",
    "@types/wav": "^1.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "libsodium-wrappers": "^0.8.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "tsdown": "^0.21.0",
    "tweetnacl": "^1.0.3",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist/"
  ]
}
